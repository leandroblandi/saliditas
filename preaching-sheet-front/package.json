{
  "name": "preaching-sheet-front",
  "version": "1.0.0",
  "description": "Aplicación Electron + Angular para gestión de planillas de predicación",
  "main": "electron/main/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "ng build && electron .",
    "electron:serve": "wait-on tcp:4200 && electron .",
    "electron:build": "ng build --base-href ./ && electron .",
    "electron:dev": "concurrently \"npm run start\" \"npm run electron:serve\"",
    "build:electron": "ng build --base-href ./ && electron-builder",
    "dist": "ng build --base-href ./ && electron-builder --publish=never"
  },
  "keywords": [
    "electron",
    "angular",
    "preaching",
    "ministry"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.0.0",
    "@angular/animations": "^18.0.0",
    "@angular/cdk": "^18.0.0",
    "@angular/cli": "^18.0.0",
    "@angular/common": "^18.0.0",
    "@angular/compiler": "^18.0.0",
    "@angular/compiler-cli": "^18.0.0",
    "@angular/core": "^18.0.0",
    "@angular/forms": "^18.0.0",
    "@angular/material": "^18.0.0",
    "@angular/platform-browser": "^18.0.0",
    "@angular/platform-browser-dynamic": "^18.0.0",
    "@angular/router": "^18.0.0",
    "@types/file-saver": "^2.0.7",
    "chart.js": "^4.4.0",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^25.1.8",
    "electron-is-dev": "^3.0.1",
    "ng2-charts": "^5.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "wait-on": "^7.2.0",
    "zone.js": "~0.14.0"
  },
  "build": {
    "appId": "com.preachingsheet.app",
    "productName": "Saliditas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/favicon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/favicon.ico"
    },
    "extraResources": [
      {
        "from": "backend/ps-api",
        "to": "backend/ps-api",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend/image-generator-api",
        "to": "backend/image-generator-api",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "node-fetch": "^2.7.0",
    "xlsx": "^0.18.5"
  }
}
